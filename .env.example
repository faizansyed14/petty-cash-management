# Supabase Session pooler (recommended for FastAPI/SQLAlchemy)
# URL-encode special chars in password (@ -> %40)
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require

JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true
